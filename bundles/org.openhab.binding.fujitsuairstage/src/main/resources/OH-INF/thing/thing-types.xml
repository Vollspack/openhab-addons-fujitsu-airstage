<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="fujitsuairstage"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<thing-type id="ac">
		<label>Fujitsu Airstage Air Conditioner</label>
		<description>Local Fujitsu Airstage WLAN module using the undocumented LAN REST API.</description>

		<channels>
			<channel id="power" typeId="power"/>
			<channel id="mode" typeId="mode"/>
			<channel id="target-temperature" typeId="target-temperature"/>
			<channel id="indoor-temperature" typeId="indoor-temperature"/>
			<channel id="outdoor-temperature" typeId="outdoor-temperature"/>
			<channel id="fan-speed" typeId="fan-speed"/>
			<channel id="vertical-direction" typeId="vertical-direction"/>
			<channel id="vertical-swing" typeId="vertical-swing"/>
			<channel id="economy" typeId="economy"/>
			<channel id="powerful" typeId="powerful"/>
			<channel id="minimum-heat" typeId="minimum-heat"/>
			<channel id="low-noise" typeId="low-noise"/>
			<channel id="fan-control" typeId="fan-control"/>
			<channel id="human-detect-auto-save" typeId="human-detect-auto-save"/>
			<channel id="error-code" typeId="error-code"/>
			<channel id="raw-status" typeId="raw-status"/>
		</channels>

		<config-description>
			<parameter name="host" type="text" required="true">
				<label>Host</label>
				<description>Hostname or IPv4 address of the Airstage WLAN module.</description>
			</parameter>
			<parameter name="deviceId" type="text" required="true">
				<label>Device ID</label>
				<description>WLAN module MAC address without colons, uppercase, for example AABBCCDDEEFF.</description>
			</parameter>
			<parameter name="refreshInterval" type="integer" required="false" min="5">
				<label>Refresh Interval</label>
				<description>Polling interval in seconds.</description>
				<default>30</default>
			</parameter>
			<parameter name="timeout" type="integer" required="false" min="500">
				<label>Timeout</label>
				<description>HTTP timeout in milliseconds.</description>
				<default>3000</default>
			</parameter>
		</config-description>
	</thing-type>

	<channel-type id="power">
		<item-type>Switch</item-type>
		<label>Power</label>
		<description>Power state.</description>
		<category>Switch</category>
		<tags>
			<tag>Switch</tag>
			<tag>Power</tag>
		</tags>
		<state readOnly="false"/>
	</channel-type>

	<channel-type id="mode">
		<item-type>Number</item-type>
		<label>Mode</label>
		<description>Operation mode: 0 AUTO, 1 COOL, 2 DRY, 3 FAN, 4 HEAT.</description>
		<category>Settings</category>
		<tags>
			<tag>Control</tag>
			<tag>Mode</tag>
		</tags>
		<state readOnly="false">
			<options>
				<option value="0">Auto</option>
				<option value="1">Cool</option>
				<option value="2">Dry</option>
				<option value="3">Fan</option>
				<option value="4">Heat</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="target-temperature">
		<item-type>Number:Temperature</item-type>
		<label>Target Temperature</label>
		<description>Temperature setpoint.</description>
		<category>Temperature</category>
		<tags>
			<tag>Setpoint</tag>
			<tag>Temperature</tag>
		</tags>
		<state min="16" max="30" step="0.5" readOnly="false" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="indoor-temperature">
		<item-type>Number:Temperature</item-type>
		<label>Indoor Temperature</label>
		<description>Indoor temperature reported by iu_indoor_tmp.</description>
		<category>Temperature</category>
		<tags>
			<tag>Measurement</tag>
			<tag>Temperature</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="outdoor-temperature">
		<item-type>Number:Temperature</item-type>
		<label>Outdoor Temperature</label>
		<description>Outdoor temperature reported by ou_outdoor_tmp when available.</description>
		<category>Temperature</category>
		<tags>
			<tag>Measurement</tag>
			<tag>Temperature</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="fan-speed">
		<item-type>Number</item-type>
		<label>Fan Speed</label>
		<description>Fan speed: 0 AUTO, 2 LOW, 5 NORMAL, 8 MEDIUM, 11 HIGH.</description>
		<category>Fan</category>
		<tags>
			<tag>Control</tag>
			<tag>Speed</tag>
		</tags>
		<state readOnly="false">
			<options>
				<option value="0">Auto</option>
				<option value="2">Low</option>
				<option value="5">Normal</option>
				<option value="8">Medium</option>
				<option value="11">High</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="vertical-direction">
		<item-type>Number</item-type>
		<label>Vertical Direction</label>
		<description>Vertical airflow direction.</description>
		<category>MoveControl</category>
		<tags>
			<tag>Control</tag>
			<tag>Tilt</tag>
		</tags>
		<state readOnly="false">
			<options>
				<option value="1">0 degrees</option>
				<option value="2">30 degrees</option>
				<option value="3">60 degrees</option>
				<option value="4">90 degrees</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="vertical-swing">
		<item-type>Switch</item-type>
		<label>Vertical Swing</label>
		<description>Vertical airflow swing.</description>
		<category>MoveControl</category>
		<tags>
			<tag>Switch</tag>
			<tag>Tilt</tag>
		</tags>
		<state readOnly="false"/>
	</channel-type>

	<channel-type id="economy">
		<item-type>Switch</item-type>
		<label>Economy</label>
		<category>Switch</category>
		<tags>
			<tag>Switch</tag>
			<tag>Mode</tag>
		</tags>
		<state readOnly="false"/>
	</channel-type>

	<channel-type id="powerful">
		<item-type>Switch</item-type>
		<label>Powerful</label>
		<category>Switch</category>
		<tags>
			<tag>Switch</tag>
			<tag>Mode</tag>
		</tags>
		<state readOnly="false"/>
	</channel-type>

	<channel-type id="minimum-heat">
		<item-type>Switch</item-type>
		<label>Minimum Heat</label>
		<category>Heating</category>
		<tags>
			<tag>Switch</tag>
			<tag>Mode</tag>
		</tags>
		<state readOnly="false"/>
	</channel-type>

	<channel-type id="low-noise">
		<item-type>Switch</item-type>
		<label>Low Noise</label>
		<category>SoundVolume</category>
		<tags>
			<tag>Switch</tag>
			<tag>Mode</tag>
		</tags>
		<state readOnly="false"/>
	</channel-type>

	<channel-type id="fan-control">
		<item-type>Switch</item-type>
		<label>Fan Control</label>
		<category>Fan</category>
		<tags>
			<tag>Switch</tag>
			<tag>Mode</tag>
		</tags>
		<state readOnly="false"/>
	</channel-type>

	<channel-type id="human-detect-auto-save">
		<item-type>Switch</item-type>
		<label>Human Detect Auto Save</label>
		<category>Presence</category>
		<tags>
			<tag>Switch</tag>
			<tag>Mode</tag>
		</tags>
		<state readOnly="false"/>
	</channel-type>

	<channel-type id="error-code">
		<item-type>String</item-type>
		<label>Error Code</label>
		<category>Error</category>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="raw-status">
		<item-type>String</item-type>
		<label>Raw Status</label>
		<description>Raw JSON status response for diagnostics.</description>
		<category>Text</category>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>
</thing:thing-descriptions>
